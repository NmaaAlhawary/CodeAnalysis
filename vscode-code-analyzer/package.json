{
  "name": "codebase-intelligence",
  "displayName": "Codebase Intelligence",
  "description": "One click. Full codebase report — dependency graph, file stats, and AI summary.",
  "version": "2.0.0",
  "publisher": "NmaaHawary",
  "engines": { "vscode": "^1.90.0" },
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "assets/icon.png",
  "galleryBanner": { "color": "#0a0a0f", "theme": "dark" },
  "keywords": ["ai", "analysis", "dependency-graph", "codebase", "report"],
  "categories": ["Other", "Visualization"],
  "repository": { "type": "git", "url": "https://github.com/NmaaAlhawary/CodeAnalysis.git" },
  "homepage": "https://github.com/NmaaAlhawary/CodeAnalysis",
  "bugs": { "url": "https://github.com/NmaaAlhawary/CodeAnalysis/issues" },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebaseIntelligence.generateReport",
        "title": "Codebase Intelligence: Generate Report"
      },
      {
        "command": "codebaseIntelligence.configureProvider",
        "title": "Codebase Intelligence: Configure AI Provider"
      }
    ],
    "configuration": {
      "id": "codeAnalyzer",
      "title": "Codebase Intelligence",
      "properties": {
        "codeAnalyzer.aiProvider": {
          "type": "string",
          "enum": ["claude", "deepseek", "gemini"],
          "enumDescriptions": [
            "Anthropic Claude — highest quality",
            "DeepSeek — fast and affordable",
            "Google Gemini — free tier available"
          ],
          "default": "deepseek",
          "description": "AI provider used for the codebase summary.",
          "scope": "application"
        },
        "codeAnalyzer.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key. Get one at https://console.anthropic.com",
          "scope": "application"
        },
        "codeAnalyzer.claudeModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Claude model name.",
          "scope": "application"
        },
        "codeAnalyzer.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key. Get one at https://platform.deepseek.com",
          "scope": "application"
        },
        "codeAnalyzer.deepseekModel": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek model name.",
          "scope": "application"
        },
        "codeAnalyzer.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Gemini API key. Get one at https://aistudio.google.com",
          "scope": "application"
        },
        "codeAnalyzer.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Gemini model name.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "package:ci": "npm run build && vsce package --no-dependencies --no-yarn",
    "verify": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
